{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push origin main)",
      "Bash(npx tsc *)",
      "Bash(/usr/local/opt/node@25/bin/npx tsc *)",
      "Bash(npm run build)",
      "Bash(/usr/local/opt/node@25/bin/npm run build)",
      "Bash(export PATH=*)",
      "Bash(npx --yes tsx *)",
      "Bash(node /tmp/*)",
      "Bash(rm /tmp/*)",
      "Bash(rm -rf .next)",
      "Bash(mkdir *)",
      "Bash(curl *)",
      "Bash(sleep *)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(git push origin --delete *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin --force *)",
      "Bash(git push origin main --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git commit --amend *)",
      "Bash(git filter-branch *)",
      "Bash(vercel *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)"
    ]
  }
}
